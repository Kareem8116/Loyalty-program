# ==============================================================================
# Pointat — Environment Variables Template
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local to git (it is in .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase — Core (required for all environments)
# Find these in: Supabase Dashboard → Project Settings → API
# ------------------------------------------------------------------------------
# The Supabase project REST + Auth URL
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe to expose to the browser — respects RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER SIDE ONLY. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# Supabase — Database Connection URLs (PLAN.md 0.4 — MANDATORY separation)
# Find these in: Supabase Dashboard → Project Settings → Database → Connection string
#
#   DATABASE_URL         → Transaction Pooler URL (port 6543, PgBouncer)
#                          Use this for raw Postgres queries from API routes.
#                          Safe for serverless: connections are pooled & released immediately.
#
#   DATABASE_DIRECT_URL  → Direct Connection URL (port 5432)
#                          ONLY for `supabase db push` and migrations.
#                          NEVER use in API routes (exhausts the 60-connection pool).
# ------------------------------------------------------------------------------
DATABASE_URL=
DATABASE_DIRECT_URL=

# ------------------------------------------------------------------------------
# Resend — Transactional Email (custom SMTP to bypass Supabase's 3-4 email/hr limit)
# Required for: OTP verification, password reset, cashier invite links
# Get key from: https://resend.com/api-keys
# ------------------------------------------------------------------------------
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# Upstash Redis — Phase 8 (subdomain→business_id cache + distributed rate limiting)
# Get from: https://console.upstash.com → Create Database → REST API
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# Cloudflare — Phase 12 (production deployment on Cloudflare Pages/Workers)
# Required for: wildcard DNS setup, edge deployment
# ------------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# Sentry — Error Monitoring & Observability (PLAN.md 0.8)
# Required before production launch.
# Get DSN from: https://pointat.sentry.io/settings/projects/javascript-nextjs/keys/
# Get Auth Token from: https://pointat.sentry.io/settings/auth-tokens/ (for source map uploads)
# ------------------------------------------------------------------------------
# Public DSN (safe to expose to browser — identifies your project, not a secret)
NEXT_PUBLIC_SENTRY_DSN=

# Auth token for source map uploads during build (server-side only)
SENTRY_AUTH_TOKEN=

